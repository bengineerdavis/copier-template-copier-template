[project]
name = "<<output_template_name>>-copier-template"
version = "0.0.0"
description = "Copier template for <<output_template_name>>"
readme = "README.md"
<% if license and not license_type.startswith('FSL') %><% if license_type == 'MIT' %>
license = "MIT"
<% elif license_type == 'Apache-2.0' %>
license = "Apache-2.0"
<% elif license_type == 'BSD-2-Clause' %>
license = "BSD-2-Clause"
<% elif license_type == 'BSD-3-Clause' %>
license = "BSD-3-Clause"
<% elif license_type == 'ISC' %>
license = "ISC"
<% elif license_type == 'MPL-2.0' %>
license = "MPL-2.0"
<% elif license_type == '0BSD' %>
license = "0BSD"
<% elif license_type == 'BlueOak-1.0.0' %>
license = "BlueOak-1.0.0"
<% elif license_type == 'CC0-1.0' %>
license = "CC0-1.0"
<% elif license_type == 'Unlicense' %>
license = "Unlicense"
<% elif license_type == 'GPL-3.0-only' %>
license = "GPL-3.0-only"
<% elif license_type == 'LGPL-3.0-only' %>
license = "LGPL-3.0-only"
<% elif license_type == 'AGPL-3.0-only' %>
license = "AGPL-3.0-only"
<% endif %><% endif %><% if license_type.startswith('FSL') %>
# FSL-1.1 identifiers are not SPDX-listed; the PEP 639 license key is omitted
<% endif %>
<% if license %>
license-files = ["LICENSE"]
<% endif %>
dependencies = [
    "copier>=9.18.2",
<% if include_pydantic_validation %>
    "copier-pydantic>=0.1.3",
<% endif %>
<% if include_template_extensions %>
    "copier-template-extensions>=0.3.2",
<% endif %>
]
requires-python = ">= << min_python_version >>"

[dependency-groups]
dev = [
    "plumbum>=1.10.0",
    "prek>=0.5.5",
    "pytest>=9.0.2",
    "pytest-gitconfig>=0.9.0",
    "python-semantic-release>=10.5.3",
    "pyyaml>=6.0.3",
]

[tool.pytest]
minversion = "9.0"
testpaths = [
    "tests",
]

[tool.semantic_release]
assets = []
build_command = """
    set -e
    uv lock --upgrade-package "$PACKAGE_NAME"
    git add uv.lock
"""
build_command_env = []
commit_message = "chore: Release version {version}\n\nAutomatically generated by python-semantic-release"
commit_parser = "conventional"
logging_use_named_masks = false
major_on_zero = false
allow_zero_version = true
no_git_verify = false
tag_format = "v{version}"
version_toml = ["pyproject.toml:project.version"]
add_partial_tags = false

[tool.semantic_release.branches.main]
match = "(main|master)"
prerelease_token = "rc"
prerelease = false

[tool.semantic_release.changelog]
exclude_commit_patterns = [
    '''chore(?:\([^)]*?\))?: .+''',
]
mode = "update"
insertion_flag = "<!-- version list -->"
template_dir = "semantic_release_templates"

[tool.semantic_release.changelog.default_templates]
changelog_file = "CHANGELOG.md"
output_format = "md"
mask_initial_release = true

[tool.semantic_release.changelog.environment]
block_start_string = "{%"
block_end_string = "%}"
variable_start_string = "{{"
variable_end_string = "}}"
comment_start_string = "{#"
comment_end_string = "#}"
trim_blocks = false
lstrip_blocks = false
newline_sequence = "\n"
keep_trailing_newline = false
extensions = []
autoescape = false

[tool.semantic_release.commit_author]
env = "GIT_COMMIT_AUTHOR"
default = "semantic-release <semantic-release>"

[tool.semantic_release.commit_parser_options]
minor_tags = ["feat"]
patch_tags = ["fix", "perf"]
other_allowed_tags = ["build", "chore", "ci", "docs", "style", "refactor", "test"]
allowed_tags = ["feat", "fix", "perf", "build", "chore", "ci", "docs", "style", "refactor", "test"]
default_bump_level = 0
parse_squash_commits = true
ignore_merge_commits = true

[tool.semantic_release.remote]
name = "origin"
type = "<< vcs_platform >>"
ignore_token_for_push = false
insecure = false

[tool.semantic_release.publish]
dist_glob_patterns = ["dist/*"]
upload_to_vcs_release = true
