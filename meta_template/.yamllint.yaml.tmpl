---
extends: default

# Copier owns this file, including its source paths and answer formatting.
ignore: |
  .copier-answers.*.yml
<% if task_management != 'none' %>
  backlog/config.yml
<% endif %>

rules:
  # renovate version comments use single space before inline comment
  comments:
    ignore: |
      .github/workflows/*.yml
  document-start:
    ignore: |
      copier.yml
      .copier-answers.*.yml
      .gitlab-ci.yml
  new-line-at-end-of-file: disable
  new-lines:
    type: unix
  line-length:
    max: 120
