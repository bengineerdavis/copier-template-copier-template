---
name: renovate

# Self-hosted Renovate: keeps pinned dev-tool versions current without the
# Mend hosted app. With GITHUB_TOKEN, PRs opened here do not trigger
# `pull_request` workflows (GitHub's recursion rule) — on-push CI catches
# breakage after merge. With a PAT, PRs get full CI.

"on":
  schedule:
    - cron: "23 4 * * 1"
  workflow_dispatch:

permissions:
  contents: read

jobs:
  renovate:
    runs-on: ubuntu-latest
    permissions:
      contents: write
      pull-requests: write
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
      - name: Run Renovate
        uses: renovatebot/github-action@2804199d260ad00c1fae0e9e842888369391c776 # v46.3.10
        with:
<% if tool_update_strategy == 'actions-github-token' %>
          token: ${{ secrets.GITHUB_TOKEN }}
<% endif %>
<% if tool_update_strategy == 'actions-pat' %>
          token: ${{ secrets.RENOVATE_TOKEN }}
<% endif %>
        env:
          RENOVATE_REPOSITORIES: "${{ github.repository }}"
