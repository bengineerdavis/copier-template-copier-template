---
name: Tests

"on":
  push:
    branches: [main]
  pull_request:
    branches: [main]
  workflow_call:

permissions:
  contents: read

env:
  PREK_HOME: .cache/prek

jobs:
  tests:
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        python-version: ["<< python_versions | join('", "') >>"]

    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0  # All git tags needed for copier

      - name: Install uv
        uses: astral-sh/setup-uv@v7
        with:
          version: "0.13.0"
          enable-cache: true

      - name: Install Python ${{ matrix.python-version }}
        run: uv python install ${{ matrix.python-version }}

      - name: Install mise
        uses: jdx/mise-action@v2
        with:
          install: false

      - name: Cache prek
        uses: actions/cache@v4
        with:
          path: ${{ env.PREK_HOME }}
          key: prek-${{ runner.os }}-py${{ matrix.python-version }}-${{ hashFiles('.pre-commit-config.yaml') }}
          restore-keys: |
            prek-${{ runner.os }}-py${{ matrix.python-version }}-

      - name: Setup environment
        run: uv sync
        env:
          UV_PYTHON: ${{ matrix.python-version }}
          MISE_TRUSTED_CONFIG_PATHS: ${{ github.workspace }}

      - name: Run tests
        run: mise run test
        env:
          UV_PYTHON: ${{ matrix.python-version }}
          MISE_TRUSTED_CONFIG_PATHS: ${{ github.workspace }}
