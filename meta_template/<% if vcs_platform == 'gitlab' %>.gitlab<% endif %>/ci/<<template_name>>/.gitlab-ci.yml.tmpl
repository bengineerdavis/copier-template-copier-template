---
tests:
  stage: test
  needs: []
  image:
    name: debian:trixie-slim
  services:
    - name: docker:dind
  parallel:
    matrix:
      - PYTHON_VERSION: ["<< python_versions | join('", "') >>"]
  variables:
    UV_CACHE_DIR: "$CI_PROJECT_DIR/.cache/uv"
    PREK_HOME: "$CI_PROJECT_DIR/.cache/prek"
    UV_PYTHON: "$PYTHON_VERSION"
    GIT_DEPTH: "0"  # All git tags needed for copier
    # When using dind service, you must instruct Docker to talk with
    # the daemon started inside of the service
    # These are usually specified by the entrypoint, if using the "docker" image
    DOCKER_HOST: tcp://docker:2376
    DOCKER_TLS_CERTDIR: "/certs"  # should be mounded by the gitlab runner
    DOCKER_TLS_VERIFY: 1
    DOCKER_CERT_PATH: "$DOCKER_TLS_CERTDIR/client"
  before_script:
    - apt-get update && apt-get install -y git curl
    - apt-get install --no-install-recommends -y docker-cli
    - curl -LsSf https://astral.sh/uv/0.13.0/install.sh | sh
    - source $HOME/.local/bin/env
    - uv python install $PYTHON_VERSION
    - curl -fsSL https://mise.run | sh
    - uv sync
  script:
    - mise run test
  cache:
    - key: tests-uv-py$PYTHON_VERSION
      paths:
        - ${UV_CACHE_DIR}
    - key: tests-prek-py$PYTHON_VERSION
      paths:
        - ${PREK_HOME}

release:
  stage: release
  image: debian:trixie-slim
  variables:
    UV_CACHE_DIR: "$CI_PROJECT_DIR/.cache/uv"
    GIT_DEPTH: "0"
  rules:
    - if: $CI_COMMIT_TAG
      when: never
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
      when: never
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH
  before_script:
    - apt-get update && apt-get install -y git curl
    - curl -LsSf https://astral.sh/uv/0.13.0/install.sh | sh
    - source $HOME/.local/bin/env
    - uv sync --group dev
  script:
    - git checkout -B "$CI_COMMIT_BRANCH" "$CI_COMMIT_SHA"
    - uv run python-semantic-release version
  resource_group: release
  interruptible: false
  cache:
    - key: release-uv
      paths:
        - ${UV_CACHE_DIR}

# note: CI sets MISE_TRUSTED_CONFIG_PATHS="$CI_PROJECT_DIR" in the job environment
