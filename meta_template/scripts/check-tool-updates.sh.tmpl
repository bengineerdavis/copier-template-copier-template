#!/usr/bin/env bash
# Report prerequisite status for this repository's configured tool-update
# strategy. The strategy was chosen when this repository was generated from
# the << template_name >> template and is recorded in the copier answers
# file.
#
# This is an informant, not a gate: it always exits 0 so it can run inside
# `mise run install` without breaking bootstrap. Fix what it flags as
# MISSING and re-run. `set -e` is deliberately omitted so one failed
# network check never truncates the report.
set -uo pipefail

ANSWERS_FILE="<<_copier_conf.answers_file>>"

ok() { printf '  OK       %s\n' "$1"; }
missing() { printf '  MISSING  %s\n' "$1"; }
unknown() { printf '  UNKNOWN  %s\n' "$1"; }
info() { printf '  INFO     %s\n' "$1"; }

strategy=""
if [[ -f $ANSWERS_FILE ]]; then
  strategy=$(grep -E '^tool_update_strategy:' "$ANSWERS_FILE" | awk '{print $2}')
fi
if [[ -z $strategy ]]; then
  strategy="github-app"
  info "no tool_update_strategy in $ANSWERS_FILE; assuming github-app"
fi
echo "Tool-update strategy: $strategy"

renovate_config() {
  if [[ -f renovate.json ]]; then
    ok "renovate.json present"
  else
    missing "renovate.json (Renovate would fall back to upstream defaults)"
  fi
}

# gh resolves PR and repo-view commands against the parent repository for
# fork checkouts, so every gh call targets the repo explicitly, derived
# from the origin remote rather than gh's own resolution.
repo_from_origin() {
  local url repo
  url=$(git remote get-url origin 2> /dev/null) || return 1
  repo="${url#*github.com[:/]}"
  repo="${repo%.git}"
  [[ -n $repo ]] || return 1
  printf '%s' "$repo"
}

gh_ready() {
  command -v gh > /dev/null 2>&1 || return 1
  gh auth status > /dev/null 2>&1 || return 1
}

case $strategy in
  github-app)
    renovate_config
    if gh_ready; then
      repo=$(repo_from_origin) || repo=""
      if [[ -n $repo ]] && gh pr list -R "$repo" --author "app/renovate" --state all --limit 1 2> /dev/null | grep -q .; then
        ok "Mend Renovate app installed and active (its PRs are on this repository)"
      else
        missing "Mend Renovate app not detected on this repository"
        info "  fix: open https://github.com/apps/renovate/installations/new (browser consent; no CLI/API install path exists)"
        info "  choose All repositories (zero-touch for future repos) or Only select repositories + this repo"
      fi
    else
      unknown "cannot verify the app install (gh missing or unauthenticated)"
      info "  manual: check this repository's PRs for renovate[bot]; install via https://github.com/apps/renovate/installations/new"
    fi
    ;;
  actions-github-token | actions-pat)
    if [[ -f .github/workflows/renovate.yml ]]; then
      ok ".github/workflows/renovate.yml present"
    else
      missing ".github/workflows/renovate.yml (not stamped or deleted)"
    fi
    if gh_ready; then
      repo=$(repo_from_origin) || repo=""
      default_branch=$(gh api "repos/$repo" --jq .default_branch 2> /dev/null || true)
      if [[ -n $repo ]] && [[ -n $default_branch ]] \
        && gh api "repos/$repo/contents/.github/workflows/renovate.yml?ref=$default_branch" > /dev/null 2>&1; then
        ok "renovate.yml is on the default branch ($default_branch); the schedule will run"
      else
        missing "renovate.yml not found on the default branch of origin"
        info "  fix: commit and push the workflow to the default branch (scheduled workflows only run from there)"
      fi
    else
      unknown "cannot verify the workflow is pushed (gh missing or unauthenticated)"
      info "  manual: the workflow must exist on the default branch of origin; push it if missing"
    fi
    if [[ $strategy == "actions-github-token" ]]; then
      info "GITHUB_TOKEN mode: Renovate PRs do not trigger pull_request CI (GitHub recursion rule); on-push CI checks them after merge"
    else
      if gh_ready && gh secret list -R "$repo" 2> /dev/null | grep -q "RENOVATE_TOKEN"; then
        ok "RENOVATE_TOKEN secret exists"
      elif gh_ready; then
        missing "RENOVATE_TOKEN secret not found"
        info "  fix: create a fine-grained PAT (Contents: read+write, Pull requests: read+write, Workflows: read+write)"
        info "  then: gh secret set RENOVATE_TOKEN"
      else
        unknown "cannot verify the RENOVATE_TOKEN secret (gh missing or unauthenticated)"
        info "  manual: Settings -> Secrets and variables -> Actions should list RENOVATE_TOKEN"
      fi
    fi
    ;;
  none)
    info "tool updates are unscheduled by design; 'mise run maintenance' still refreshes lockfiles"
    info "switch strategies later by re-running the template update (copier re-asks the question)"
    ;;
  *)
    missing "unknown strategy '$strategy' in $ANSWERS_FILE"
    ;;
esac

exit 0
